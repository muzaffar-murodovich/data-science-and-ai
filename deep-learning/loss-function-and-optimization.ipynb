   "source": [
    "import numpy as np\n",
    "\n",
    "def loss(x):\n",
    "    return (x - 3) ** 2\n",
    "\n",
    "def grad(x):\n",
    "    return 2 * (x - 3)\n",
    "\n",
    "x = 0\n",
    "Lx = 0.1\n",
    "for i in range (10):\n",
    "    x -= Lx * grad(x)\n",
    "    print(f\"Step {i+1}: x = {x:.4f}, loss = {loss(x):.4f}\")"
   ]
